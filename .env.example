# --- Service ---
SERVICE_NAME=fastapi101
LOCAL_URL=localhost:5000

# --- API ---
API_VERSION=1.0.0
API_PORT=8000
API_EXPOSE_PORT=8000
API_ENV=dev

# --- Postgres (what the API connects to) ---
# Use POSTGRES_HOST=localhost when running the API outside docker
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=postgres
